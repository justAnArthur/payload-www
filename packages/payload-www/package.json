{
  "name": "@justanarthur/payload-www",
  "description": "Reusable Payload CMS website template — config builder, collections, globals, blocks, fields, access, hooks, metadata (JSON-LD, hreflang), page renderers, and test helpers.",
  "version": "2.2.2",
  "type": "module",
  "private": false,
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "payload-www": "./dist/cli.js"
  },
  "exports": {
    "./translator": {
      "import": {
        "types": "./dist/translator.d.ts",
        "default": "./dist/translator.js"
      }
    },
    "./render-pages": {
      "import": {
        "types": "./dist/render-pages.d.ts",
        "default": "./dist/render-pages.js"
      }
    },
    "./metadata": {
      "import": {
        "types": "./dist/metadata.d.ts",
        "default": "./dist/metadata.js"
      }
    },
    "./config": {
      "import": {
        "types": "./dist/config.d.ts",
        "default": "./dist/config.js"
      }
    },
    "./imagehash": {
      "import": {
        "types": "./dist/imagehash.d.ts",
        "default": "./dist/imagehash.js"
      }
    },
    "./mcp": {
      "import": {
        "types": "./dist/mcp.d.ts",
        "default": "./dist/mcp.js"
      }
    },
    "./blocks": {
      "import": {
        "types": "./dist/blocks.d.ts",
        "default": "./dist/blocks.js"
      }
    },
    "./collections": {
      "import": {
        "types": "./dist/collections.d.ts",
        "default": "./dist/collections.js"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/utils.d.ts",
        "default": "./dist/utils.js"
      }
    },
    "./pages": {
      "import": {
        "types": "./dist/pages.d.ts",
        "default": "./dist/pages.js"
      }
    },
    "./access": {
      "import": {
        "types": "./dist/access.d.ts",
        "default": "./dist/access.js"
      }
    },
    "./import-map-provider": {
      "import": {
        "types": "./dist/import-map-provider.d.ts",
        "default": "./dist/import-map-provider.js"
      }
    },
    "./fields": {
      "import": {
        "types": "./dist/fields.d.ts",
        "default": "./dist/fields.js"
      }
    },
    "./sitemap": {
      "import": {
        "types": "./dist/sitemap.d.ts",
        "default": "./dist/sitemap.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "NODE_ENV=production bunup && node scripts/strip-createRequire.mjs && bun run build:cli",
    "build:lib": "NODE_ENV=production bunup",
    "build:cli": "bun build src/cli/index.ts --target node --format esm --outfile dist/cli.js --external tsx --external 'tsx/esm/api'",
    "clean": "rm -rf dist .tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run clean && bun run build"
  },
  "dependencies": {
    "@payloadcms/live-preview-react": "3.88.0",
    "@payloadcms/plugin-mcp": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "next": "16.3.4",
    "next-intl": "^4.14.2",
    "server-only": "0.0.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "bunup": "^0.16.32",
    "payload": "3.88.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "^7.0.2",
    "vitest": "4.0.18"
  },
  "peerDependencies": {
    "@payloadcms/live-preview-react": "^3.85.0",
    "@payloadcms/next": "^3.85.0",
    "@payloadcms/richtext-lexical": "^3.85.0",
    "@payloadcms/translations": "^3.85.0",
    "@payloadcms/ui": "^3.85.0",
    "@pro-laico/core": "^0.5.0",
    "@pro-laico/payload-revalidate": "^0.8.5",
    "next": "^16.2.6",
    "next-intl": "^4.0.0",
    "payload": "^3.85.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "@justanarthur/payload-plugin-seo": "^4.0.0",
    "@justanarthur/payload-plugin-translator": "^3.1.1",
    "@justanarthur/payload-imagehash-plugin": "^3.3.0"
  },
  "properties": {
    "gitCommitScopeRelatedNames": "payload-www,render,revalidation,www",
    "priority": 1
  }
}